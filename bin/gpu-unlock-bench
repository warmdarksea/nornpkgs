#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Before/after benchmark for the gpu-unlock FP/BF16 issue-rate unlock.

The unlock doubles the FP/BF16 FMA issue rate, which shows up as dense GEMM
throughput (FP16 / BF16 / TF32, FP32 accumulation) -- the same thing upstream
measured. This times that GEMM, records the surrounding state that explains
the number (power limit, clocks, driver, and the gpu_unlock kernel log), and
can diff two runs.

Typical use:

    # before the unlock (stock boot, no gpu_unlock.targets=)
    ./gpu-unlock-bench run --label before -o before.json

    # reboot with the unlock enabled, then:
    ./gpu-unlock-bench run --label after  -o after.json

    ./gpu-unlock-bench compare before.json after.json

Needs PyTorch with CUDA. `run` works fine as an unprivileged user; it reads the
kernel log best-effort (that part may be empty without journal access, which is
harmless). A square GEMM at the default size uses a few hundred MB of VRAM
(FP32) -- lower --size on smaller cards.
"""
from __future__ import annotations

import argparse
import json
import platform
import shutil
import statistics
import subprocess
import sys
from datetime import datetime, timezone


# dtype -> (human label, needs_tf32_flag). "tf32" runs FP32 inputs through the
# TF32 tensor-core path; "fp32" is the full-precision path the unlock does NOT
# touch, kept as a reference that should stay flat before/after.
DTYPES = {
    "fp16": "FP16",
    "bf16": "BF16",
    "tf32": "TF32",
    "fp32": "FP32 (reference)",
}


def _run_cmd(argv):
    """Run a command, returning stripped stdout or None (never raises)."""
    if not shutil.which(argv[0]):
        return None
    try:
        out = subprocess.run(
            argv, capture_output=True, text=True, timeout=15, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def nvidia_smi(index):
    """Per-GPU state that explains the throughput number."""
    fields = [
        "name",
        "pci.bus_id",
        "driver_version",
        "power.limit",
        "enforced.power.limit",
        "clocks.sm",
        "clocks.mem",
        "temperature.gpu",
    ]
    out = _run_cmd(
        [
            "nvidia-smi",
            f"--query-gpu={','.join(fields)}",
            "--format=csv,noheader,nounits",
            "-i",
            str(index),
        ]
    )
    if not out:
        return {}
    values = [v.strip() for v in out.splitlines()[0].split(",")]
    return dict(zip(fields, values))


def kernel_log():
    """Best-effort gpu_unlock lines from the current boot's kernel log.

    Captures whether the unlock actually ran, so a run is self-describing.
    Returns [] when no log is readable (unprivileged, no journal) -- not an
    error.
    """
    for argv in (
        ["journalctl", "-k", "-b", "--no-pager", "-q"],
        ["dmesg"],
    ):
        out = _run_cmd(argv)
        if out is not None:
            lines = [ln for ln in out.splitlines() if "gpu_unlock" in ln]
            return lines[-40:]
    return []


def benchmark(torch, index, size, dtypes, samples, iters, warmup):
    device = torch.device(f"cuda:{index}")
    torch.cuda.set_device(device)
    results = {}

    for key in dtypes:
        label = DTYPES[key]
        # TF32 is a mode over FP32 inputs, not a dtype; toggle the flag to pick
        # the tensor-core path vs. true FP32.
        if key in ("tf32", "fp32"):
            tdtype = torch.float32
            torch.backends.cuda.matmul.allow_tf32 = key == "tf32"
            torch.backends.cudnn.allow_tf32 = key == "tf32"
        else:
            tdtype = {"fp16": torch.float16, "bf16": torch.bfloat16}[key]
            torch.backends.cuda.matmul.allow_tf32 = False

        # Deterministic inputs (seeded), scaled so outputs stay O(1) and fit
        # FP16 range. Same seed before/after -> a meaningful output checksum.
        torch.manual_seed(0x3090)
        scale = 0.1
        a = (torch.randn(size, size, device=device, dtype=torch.float32) * scale).to(tdtype)
        b = (torch.randn(size, size, device=device, dtype=torch.float32) * scale).to(tdtype)
        c = torch.empty(size, size, device=device, dtype=tdtype)

        for _ in range(warmup):
            torch.mm(a, b, out=c)
        torch.cuda.synchronize()

        flop = 2.0 * size * size * size  # one multiply-add = 2 flop
        tflops = []
        start = torch.cuda.Event(enable_timing=True)
        end = torch.cuda.Event(enable_timing=True)
        for _ in range(samples):
            start.record()
            for _ in range(iters):
                torch.mm(a, b, out=c)
            end.record()
            torch.cuda.synchronize()
            seconds_per_op = (start.elapsed_time(end) / 1000.0) / iters
            tflops.append(flop / seconds_per_op / 1e12)

        # Checksum in float64 (fp16/bf16 sums would overflow/lose precision).
        checksum = float(c.double().sum().item())
        results[key] = {
            "label": label,
            "tflops_median": statistics.median(tflops),
            "tflops_min": min(tflops),
            "tflops_max": max(tflops),
            "tflops_samples": tflops,
            "output_checksum": checksum,
        }
        del a, b, c
        torch.cuda.empty_cache()
        print(
            f"  {label:<16} {results[key]['tflops_median']:8.2f} TFLOPS "
            f"(min {results[key]['tflops_min']:.2f}, max {results[key]['tflops_max']:.2f})"
        )
    return results


def cmd_run(args):
    try:
        import torch
    except ImportError:
        sys.exit(
            "error: PyTorch is required. On nornpkgs, the py-hellotorch template "
            "gives a torch devshell:\n"
            "  nix flake init -t github:warmdarksea/nornpkgs#py-hellotorch"
        )
    if not torch.cuda.is_available():
        sys.exit("error: CUDA is not available to PyTorch (no usable NVIDIA GPU?).")
    if args.gpu >= torch.cuda.device_count():
        sys.exit(
            f"error: --gpu {args.gpu} out of range; "
            f"{torch.cuda.device_count()} CUDA device(s) visible."
        )

    dtypes = [d.strip() for d in args.dtypes.split(",") if d.strip()]
    bad = [d for d in dtypes if d not in DTYPES]
    if bad:
        sys.exit(f"error: unknown dtype(s): {', '.join(bad)}. Choose from {', '.join(DTYPES)}.")

    props = torch.cuda.get_device_properties(args.gpu)
    smi = nvidia_smi(args.gpu)
    print(f"GPU {args.gpu}: {props.name}  ({smi.get('pci.bus_id', '?')})")
    pl = smi.get("enforced.power.limit") or smi.get("power.limit")
    if pl:
        print(f"  power limit: {pl} W   sm clock: {smi.get('clocks.sm', '?')} MHz   "
              f"driver: {smi.get('driver_version', '?')}")
    unlock_log = kernel_log()
    unlocked = any("unlocked" in ln for ln in unlock_log)
    print(f"  gpu_unlock kernel log: "
          f"{'present' if unlock_log else 'not found'}"
          f"{' (reports unlocked)' if unlocked else ''}")
    print(f"  N={args.size}, samples={args.samples}, iters/sample={args.iters}\n")

    results = benchmark(
        torch, args.gpu, args.size, dtypes, args.samples, args.iters, args.warmup
    )

    record = {
        "schema": "gpu-unlock-bench/1",
        "label": args.label,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "host": platform.node(),
        "size": args.size,
        "samples": args.samples,
        "iters": args.iters,
        "gpu": {
            "index": args.gpu,
            "name": props.name,
            "total_memory_bytes": props.total_memory,
            "capability": f"{props.major}.{props.minor}",
            "nvidia_smi": smi,
        },
        "torch": {"version": torch.__version__, "cuda": torch.version.cuda},
        "gpu_unlock_kernel_log": unlock_log,
        "gpu_unlock_reports_unlocked": unlocked,
        "results": results,
    }

    if args.output:
        with open(args.output, "w") as fh:
            json.dump(record, fh, indent=2)
        print(f"\nwrote {args.output}")
    return record


def _load(path):
    with open(path) as fh:
        data = json.load(fh)
    if data.get("schema") != "gpu-unlock-bench/1":
        sys.exit(f"error: {path} is not a gpu-unlock-bench run.")
    return data


def cmd_compare(args):
    before = _load(args.before)
    after = _load(args.after)

    def tag(d):
        return f"{d.get('label') or '?'} ({d['gpu']['name']})"

    print(f"before: {tag(before)}  N={before['size']}")
    print(f"after:  {tag(after)}  N={after['size']}\n")

    if before["size"] != after["size"]:
        print("!! sizes differ; TFLOPS are comparable but not the exact same work\n")

    def power(d):
        smi = d["gpu"].get("nvidia_smi", {})
        return smi.get("enforced.power.limit") or smi.get("power.limit")

    pb, pa = power(before), power(after)
    if pb and pa and pb != pa:
        print(f"!! power limit differs: before {pb} W vs after {pa} W -- "
              f"this alone changes GEMM throughput; match them for a fair test\n")

    header = f"{'Input':<16} {'Before':>14} {'After':>14} {'Change':>9}  {'Output':>10}"
    print(header)
    print("-" * len(header))
    for key, label in DTYPES.items():
        rb = before["results"].get(key)
        ra = after["results"].get(key)
        if not rb or not ra:
            continue
        tb = rb["tflops_median"]
        ta = ra["tflops_median"]
        change = f"{(ta / tb - 1.0) * 100:+.0f}%" if tb else "n/a"
        same = "identical" if rb["output_checksum"] == ra["output_checksum"] else "DIFFERS"
        print(f"{label:<16} {tb:>10.2f} TF {ta:>10.2f} TF {change:>9}  {same:>10}")

    print("\n(Output column compares the result checksum -- for the unlock it "
          "should read 'identical'; 'DIFFERS' means the math changed, not just "
          "the speed.)")


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run", help="benchmark the GPU and write a JSON run")
    run.add_argument("--label", default=None, help="tag for this run, e.g. before/after")
    run.add_argument("-o", "--output", default=None, help="write the run to this JSON file")
    run.add_argument("--gpu", type=int, default=0, help="CUDA device index (default 0)")
    run.add_argument("--size", type=int, default=8192, help="square GEMM dimension (default 8192)")
    run.add_argument("--dtypes", default="fp16,bf16,tf32,fp32",
                     help="comma list from fp16,bf16,tf32,fp32 (default all)")
    run.add_argument("--samples", type=int, default=5, help="timed samples per dtype (median; default 5)")
    run.add_argument("--iters", type=int, default=50, help="GEMMs per sample (default 50)")
    run.add_argument("--warmup", type=int, default=10, help="warmup GEMMs per dtype (default 10)")
    run.set_defaults(func=cmd_run)

    cmp_ = sub.add_parser("compare", help="diff two JSON runs")
    cmp_.add_argument("before")
    cmp_.add_argument("after")
    cmp_.set_defaults(func=cmd_compare)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
